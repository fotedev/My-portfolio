# Environment variable NAMES for fotedev/My-portfolio (values never committed).
# Copy to .env.local and fill in locally; set the same names in Vercel project env vars.

# --- Supabase (public to the browser; access governed by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — bypasses RLS; never NEXT_PUBLIC_*, never client-side) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (contact pipeline, wired in M4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email provider for inquiry notifications (chosen in M4, ADR-0008) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_NAME=
EMAIL_FROM=

# --- Anti-abuse ---
IP_HASH_SALT=

# --- Edge Function runtime (set as Supabase function secrets, not Vercel) ---
# Comma-separated CORS + Turnstile hostname allowlist, no wildcards in production
ALLOWED_ORIGINS=
# Notification recipient (defaults to the site_settings contact email)
OWNER_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Hero lattice (ADR-0010) ---
# Set to 0 to remove the WebGL hero layer entirely. The kill switch for the
# Lighthouse gate; the layer is on by default.
NEXT_PUBLIC_HERO_HIVE=1

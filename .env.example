# Environment variable NAMES for fotedev/My-portfolio (values never committed).
# Copy to .env.local and fill in locally; set the same names in Vercel project env vars.

# --- Supabase (public to the browser; access governed by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — bypasses RLS; never NEXT_PUBLIC_*, never client-side) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Turnstile (contact pipeline, wired in M4) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email provider for inquiry notifications (chosen in M4, ADR-0008) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_NAME=
EMAIL_FROM=

# --- Anti-abuse ---
IP_HASH_SALT=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
